# ==============================================================================
# VIETLANGAI BACKEND - ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in the environment-specific values.
# NEVER commit a real .env file containing production credentials to Git.
# ==============================================================================

APP_ENV=development
APP_NAME="Ngôn Sắc Việt"

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (AWS RDS PostgreSQL / Supabase / Local SQLite)
# ------------------------------------------------------------------------------
# Option A: AWS RDS PostgreSQL (Private Subnet, Port 5432, SSL enabled)
# DATABASE_URL=postgresql+asyncpg://vietlang_admin:CHANGE_ME@vietlangai-rds.xxxx.ap-southeast-1.rds.amazonaws.com:5432/vietlangai
# DB_SSL_REQUIRE=true
# DB_STATEMENT_CACHE_SIZE=0
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Option B: Supabase Postgres connection string (transaction pooler, port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DB_SSL_REQUIRE=true
DB_STATEMENT_CACHE_SIZE=0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Option C: Offline local development without PostgreSQL
# DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT + Argon2)
# ------------------------------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# Seeding & Moderation Rules
AUTO_SEED=true
# Set SEED_DEMO_USER=false and ALLOW_SELF_REVIEW=false in production!
SEED_DEMO_USER=false
ALLOW_SELF_REVIEW=false

# ------------------------------------------------------------------------------
# 3. AI / ML SERVICE INTEGRATION
# ------------------------------------------------------------------------------
ML_BASE_URL=http://127.0.0.1:8100
ML_API_KEY=
ML_TEXT_TIMEOUT=60
ML_FILE_TIMEOUT=180

MAX_IMAGE_MB=8
MAX_AUDIO_MB=20

# ------------------------------------------------------------------------------
# 4. CORS & RATE LIMITING
# ------------------------------------------------------------------------------
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Optional Supabase client config for Flutter direct public catalog reads
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=
