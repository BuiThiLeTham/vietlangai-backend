# Copy to /opt/vietlangai/be/.env on EC2 (never commit real secrets).
APP_ENV=production
APP_NAME="Ngôn Sắc Việt"

DATABASE_URL=postgresql+asyncpg://vietlang_admin:CHANGE_ME@vietlangai-rds.xxxx.ap-southeast-1.rds.amazonaws.com:5432/vietlangai
DB_SSL_REQUIRE=true
DB_STATEMENT_CACHE_SIZE=0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

AUTO_SEED=false
SEED_DEMO_USER=false
ALLOW_SELF_REVIEW=false

ML_BASE_URL=http://127.0.0.1:8100
ML_API_KEY=
ML_TEXT_TIMEOUT=90
ML_FILE_TIMEOUT=180

GOOGLE_CLIENT_IDS=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

CORS_ORIGINS=https://ngonsacviet.ourvibe.tech,https://ngonsacviet.pages.dev
CORS_ORIGIN_REGEX=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

LANGUAGES_CATALOG=/opt/vietlangai/shared/languages.json
GLOSSARY_EXPORT_PATH=/opt/vietlangai/ai-model/data/reviewed_pairs.csv
